# Copy to .env to override defaults: Copy-Item .env.example .env
# Everything has a default in docker-compose.yml, so .env is optional.
# .env is gitignored. Never commit it: this repo is PUBLIC.

# --- Postgres ---
POSTGRES_USER=paypulse
POSTGRES_PASSWORD=paypulse
POSTGRES_DB=paypulse
# Host port, so you can connect with psql or a DB GUI from the demo PC.
POSTGRES_PORT=5432

# --- payment-service ---
PAYMENT_SERVICE_PORT=8080
# Background fake payments per second. 0 turns the generator off.
TRAFFIC_RPS=5
LOG_LEVEL=INFO

# --- LLM (used from Phase 3) ---
# Jarvislabs Token Factory, OpenAI-compatible. Put the real key only in .env.
LLM_BASE_URL=https://models.jarvislabs.net/v1
LLM_MODEL=deepseek-v4.1-flash-1017
LLM_API_KEY=
