# Copy to .env to override defaults: Copy-Item .env.example .env
# Everything has a default in docker-compose.yml, so .env is optional.
# .env is gitignored. Never commit it: this repo is PUBLIC.

# --- Postgres ---
POSTGRES_USER=paypulse
POSTGRES_PASSWORD=paypulse
POSTGRES_DB=paypulse
# Host port, so you can connect with psql or a DB GUI from the demo PC.
POSTGRES_PORT=5432

# --- payment-service ---
PAYMENT_SERVICE_PORT=8080
# Background fake payments per second. 0 turns the generator off.
# 20 gives ~150 payments per bank+method per minute, so normal ~2% failures never
# cross the 90% alert threshold by chance (at 5, false incidents opened).
TRAFFIC_RPS=20
LOG_LEVEL=INFO

# --- Command Center ---
UI_PORT=3000
API_PORT=8000

# --- LLM: Jarvislabs Token Factory (OpenAI-compatible) ---
# Required for the AI root-cause step. Put the real key only in .env.
LLM_BASE_URL=https://models.jarvislabs.net/v1
LLM_MODEL=deepseek-v4.1-flash-1017
LLM_API_KEY=

# --- Supermemory: past incidents and fixes ---
# Optional: without it, investigations run without memory. Key from console.supermemory.ai.
SUPERMEMORY_API_KEY=
